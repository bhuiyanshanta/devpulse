{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",                         
    "moduleResolution": "bundler",                
    "rootDir": "./",
    "outDir": "./dist",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "forceConsistentCasingInFileNames": true,
    "strict": true
  },
  "include": [
    "src/**/*",
    "api/**/*"
  ]
}
